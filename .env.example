# Required: your Gemini API key from https://aistudio.google.com/apikey
# It stays on the server (Netlify Function); the browser only ever gets a short-lived, single-use token.
GEMINI_API_KEY=

# Optional: override the Live API model (check https://ai.google.dev/gemini-api/docs/models for current IDs)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: if set, learners must enter this code before starting a conversation (protects your API quota)
# ACCESS_CODE=
