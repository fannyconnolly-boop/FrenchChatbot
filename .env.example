# Required: your Gemini API key from https://aistudio.google.com/apikey
# It stays on the server (Netlify Function); the browser only ever gets a short-lived, single-use token.
GEMINI_API_KEY=

# Optional: override the Live API model (check https://ai.google.dev/gemini-api/docs/models for current IDs)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional: text model used to write the end-of-conversation feedback report
# GEMINI_FEEDBACK_MODEL=gemini-3.8-flash

# Optional: if set, learners must enter this code before starting a conversation (protects your API quota)
# ACCESS_CODE=

# Optional: well-being alerts. When Camille notices a safety concern she pauses the chat and emails the teacher.
# Sign up at https://resend.com with the address below, create an API key, and paste it here.
# TEACHER_EMAIL=
# RESEND_API_KEY=
# TEACHER_TIMEZONE=America/New_York
